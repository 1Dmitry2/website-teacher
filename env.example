# Database Configuration
POSTGRES_DB=restapi_prod
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_this_password
POSTGRES_PORT=5432

# Backend Configuration
BACKEND_PORT=8080
JWT_SECRET=your-super-secret-key-minimum-32-characters-long-for-security-change-this-in-production

# SMTP Configuration (for email verification and password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com

# Frontend Configuration
FRONTEND_PORT=80
VITE_API_URL=http://localhost:8080

# Nginx Configuration
NGINX_PORT=8000

# URLs for email links (change to your domain)
ADMIN_RESET_URL=http://localhost/admin/reset?token=
USER_VERIFICATION_URL=http://localhost/verify-email?token=

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost

